generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  DECLINED
  CONVERTED
  ARCHIVED
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ProjectStatus {
  INTAKE
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  WAITING_FOR_CLIENT
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  SHARED
  CHANGES_REQUESTED
  APPROVED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum MessageVisibility {
  CLIENT_VISIBLE
  INTERNAL
}

enum Role {
  CUSTOMER
  CREATOR
  ADMIN
}

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectOfferStatus {
  SENT
  COUNTERED_BY_CREATOR
  COUNTERED_BY_ADMIN
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum OfferNegotiationAction {
  OFFER
  COUNTER
  ACCEPT
  DECLINE
  WITHDRAW
}

enum OfferNegotiationActor {
  ADMIN
  CREATOR
  SYSTEM
}

enum EarningType {
  PROJECT_PAYMENT
  MILESTONE
  BONUS
  ADJUSTMENT
  DEDUCTION
}

enum EarningStatus {
  PENDING
  APPROVED
  IN_PAYOUT
  PAID
  ON_HOLD
  CANCELLED
}

// ------------------------------------
// BETTER AUTH
// ------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  appRole       Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // AdSpolisher relations
  quoteRequests        QuoteRequest[]
  clientProjects       Project[]         @relation("ProjectClient")
  assignedProjects     Project[]         @relation("ProjectAssignee")
  assignedQuotes       QuoteRequest[]    @relation("QuoteAssignee")
  createdProposals     Proposal[]       @relation("ProposalCreator")
  reviewedApplications CreatorApplication[] @relation("CreatorApplicationReviewer")
  sentInvitations      StaffInvitation[] @relation("InvitationSender")
  acceptedInvitations  StaffInvitation[] @relation("InvitationAcceptedBy")
  projectMessages      ProjectMessage[]
  uploadedDeliverables Deliverable[]     @relation("DeliverableUploader")
  projectMemberships   ProjectTeamMember[]
  creatorOffers        ProjectOffer[] @relation("OfferCreator")
  sentCreatorOffers    ProjectOffer[] @relation("OfferAdmin")
  offerNegotiations    OfferNegotiationEntry[]
  creatorEarnings      EarningEntry[] @relation("EarningCreator")
  auditLogs            AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  adminOtpVerified  Boolean            @default(false)
  adminOtpChallenge AdminOtpChallenge?
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ------------------------------------
// SERVICES AND PACKAGES
// ------------------------------------

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String
  description      String           @db.Text
  status           ServiceStatus    @default(DRAFT)
  featured         Boolean          @default(false)
  sortOrder        Int              @default(0)
  coverImageUrl    String?
  packages         ServicePackage[]
  quoteRequests    QuoteRequest[]
  projects         Project[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, sortOrder])
}

model ServicePackage {
  id             String         @id @default(cuid())
  serviceId      String?
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name           String
  slug           String         @unique
  tagline        String?
  badge          String?
  description    String         @db.Text
  price          Decimal?       @db.Decimal(10, 2)
  currency       String         @default("INR") @db.VarChar(3)
  billingPeriod  String?        @default("one-time")
  deliverables   Json?
  turnaroundDays Int?
  revisionLimit  Int?
  isPopular      Boolean        @default(false)
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  quoteRequests  QuoteRequest[]
  projects       Project[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@index([serviceId])
}

// ------------------------------------
// GUEST OR AUTHENTICATED QUOTE REQUESTS
// ------------------------------------

model QuoteRequest {
  id              String      @id @default(cuid())
  name            String
  email           String
  companyName     String?
  companyWebsite  String?
  country         String?
  message         String      @db.Text
  goals           String?     @db.Text
  budgetRange     String?
  desiredDeadline DateTime?
  attachments     Json?
  status          QuoteStatus @default(NEW)
  internalNotes   String?     @db.Text

  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId    String?
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId    String?
  package      ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?           @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  project      Project?
  proposals    Proposal[]

  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
}

model Proposal {
  id             String         @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest   @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User           @relation("ProposalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title          String
  summary        String         @db.Text
  deliverables   Json?
  price          Decimal        @db.Decimal(10, 2)
  currency       String         @default("USD") @db.VarChar(3)
  timeline       String?
  revisionLimit  Int?
  paymentTerms   String?        @db.Text
  expiresAt      DateTime?
  status         ProposalStatus @default(DRAFT)
  sentAt         DateTime?
  viewedAt       DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([quoteRequestId, createdAt])
  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model CreatorApplication {
  id                  String                    @id @default(cuid())
  name                String
  email               String
  location            String
  portfolioUrl        String
  secondaryUrl        String?
  craftSpecialty      String
  primaryTools        String
  experienceLevel     String
  weeklyAvailability  String
  notes               String?                   @db.Text
  fileSummaries       Json?
  status              CreatorApplicationStatus  @default(PENDING)
  reviewNotes         String?                   @db.Text
  reviewedAt          DateTime?
  reviewedById        String?
  reviewedBy          User?                     @relation("CreatorApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([reviewedById, reviewedAt])
}

// ------------------------------------
// ACCEPTED WORK AND CLIENT COMMUNICATION
// ------------------------------------

model Project {
  id          String        @id @default(cuid())
  projectCode String        @unique
  title       String
  brief       String        @db.Text
  status      ProjectStatus @default(INTAKE)
  budget      Decimal?      @db.Decimal(10, 2)
  currency    String        @default("USD") @db.VarChar(3)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  clientId       String
  client         User            @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  assignedToId   String?
  assignedTo     User?           @relation("ProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  serviceId      String?
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId      String?
  package        ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quoteRequestId String?         @unique
  quoteRequest   QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  messages     ProjectMessage[]
  deliverables Deliverable[]
  teamMembers  ProjectTeamMember[]
  offers       ProjectOffer[]
  creatorEarnings EarningEntry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId, updatedAt])
  @@index([status, dueDate])
  @@index([assignedToId, status])
}

model ProjectTeamMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle String?  @default("Creator")
  offerId   String?  @unique
  offer     ProjectOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectOffer {
  id             String            @id @default(cuid())
  offerCode      String            @unique
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        User              @relation("OfferCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  offeredById    String
  offeredBy      User              @relation("OfferAdmin", fields: [offeredById], references: [id], onDelete: Restrict)
  roleTitle      String            @default("Creator")
  scopeSummary   String            @db.Text
  paymentTerms   String?           @db.Text
  currency       String            @default("INR") @db.VarChar(3)
  currentAmount  Decimal           @db.Decimal(10, 2)
  acceptedAmount Decimal?          @db.Decimal(10, 2)
  proposedDueDate DateTime?
  expiresAt      DateTime?
  status         ProjectOfferStatus @default(SENT)
  currentRound   Int               @default(1)
  maxRounds      Int               @default(3)
  declineReason  String?           @db.Text
  sentAt         DateTime          @default(now())
  respondedAt    DateTime?
  negotiation    OfferNegotiationEntry[]
  teamMember     ProjectTeamMember?
  earningEntry   EarningEntry?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([creatorId, status])
  @@index([projectId, status])
  @@index([status, expiresAt])
}

model OfferNegotiationEntry {
  id        String                  @id @default(cuid())
  offerId   String
  offer     ProjectOffer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  round     Int
  action    OfferNegotiationAction
  actorRole OfferNegotiationActor
  actorId   String?
  actor     User?                   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  amount    Decimal?                @db.Decimal(10, 2)
  message   String?                 @db.Text
  createdAt DateTime                @default(now())

  @@index([offerId, createdAt])
}

model EarningEntry {
  id        String       @id @default(cuid())
  creatorId String
  creator   User         @relation("EarningCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  offerId   String?      @unique
  offer     ProjectOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  type      EarningType  @default(PROJECT_PAYMENT)
  status    EarningStatus @default(PENDING)
  label     String?
  currency  String       @default("INR") @db.VarChar(3)
  amount    Decimal      @db.Decimal(10, 2)
  approvedAt DateTime?
  paidAt     DateTime?
  holdReason String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([creatorId, status])
  @@index([projectId])
}

model ProjectMessage {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body       String            @db.Text
  visibility MessageVisibility @default(CLIENT_VISIBLE)
  createdAt  DateTime          @default(now())

  @@index([projectId, createdAt])
  @@index([senderId, createdAt])
}

model Deliverable {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?           @db.Text
  fileUrl      String
  storageKey   String?           @unique
  previewUrl   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  version      Int               @default(1)
  status       DeliverableStatus @default(DRAFT)
  uploadedById String?
  uploadedBy   User?             @relation("DeliverableUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  sharedAt     DateTime?
  approvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// ------------------------------------
// PUBLIC CONTACT INQUIRIES
// ------------------------------------

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ------------------------------------
// PORTFOLIO AND TESTIMONIAL CONTENT
// ------------------------------------

model PortfolioItem {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  summary       String    @db.Text
  industry      String?
  challenge     String?   @db.Text
  approach      String?   @db.Text
  outcomes      String?   @db.Text
  coverImageUrl String?
  gallery       Json?
  isConceptWork Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

model Testimonial {
  id                  String            @id @default(cuid())
  customerName        String
  customerTitle       String?
  companyName         String?
  quote               String            @db.Text
  rating              Int?
  permissionConfirmed Boolean           @default(false)
  status              TestimonialStatus @default(DRAFT)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, sortOrder])
}

// ------------------------------------
// INVITATIONS, OTP CHALLENGES, AND AUDIT LOGS
// ------------------------------------

model StaffInvitation {
  id           String    @id @default(cuid())
  email        String
  invitedRole  String
  tokenHash    String    @unique
  invitedById  String
  invitedBy    User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model AdminOtpChallenge {
  id         String    @id @default(uuid())
  sessionId  String    @unique
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}
