generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  NEEDS_INFORMATION
  ACCEPTED
  DECLINED
  CONVERTED
  ARCHIVED
}

enum ProjectStatus {
  INTAKE
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  WAITING_FOR_CLIENT
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  SHARED
  CHANGES_REQUESTED
  APPROVED
}

enum ContactMessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum MessageVisibility {
  CLIENT_VISIBLE
  INTERNAL
}

enum Role {
  CUSTOMER
  CREATOR
  ADMIN
}

// ------------------------------------
// BETTER AUTH
// ------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  appRole       Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // AdSpolisher relations
  quoteRequests        QuoteRequest[]
  clientProjects       Project[]         @relation("ProjectClient")
  assignedProjects     Project[]         @relation("ProjectAssignee")
  assignedQuotes       QuoteRequest[]    @relation("QuoteAssignee")
  sentInvitations      StaffInvitation[] @relation("InvitationSender")
  acceptedInvitations  StaffInvitation[] @relation("InvitationAcceptedBy")
  projectMessages      ProjectMessage[]
  uploadedDeliverables Deliverable[]     @relation("DeliverableUploader")
  auditLogs            AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  adminOtpVerified  Boolean            @default(false)
  adminOtpChallenge AdminOtpChallenge?
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ------------------------------------
// SERVICES AND PACKAGES
// ------------------------------------

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  shortDescription String
  description      String           @db.Text
  status           ServiceStatus    @default(DRAFT)
  featured         Boolean          @default(false)
  sortOrder        Int              @default(0)
  coverImageUrl    String?
  packages         ServicePackage[]
  quoteRequests    QuoteRequest[]
  projects         Project[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, sortOrder])
}

model ServicePackage {
  id             String         @id @default(cuid())
  serviceId      String
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String         @db.Text
  price          Decimal?       @db.Decimal(10, 2)
  currency       String         @default("USD") @db.VarChar(3)
  deliverables   Json?
  turnaroundDays Int?
  revisionLimit  Int?
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  quoteRequests  QuoteRequest[]
  projects       Project[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([serviceId, slug])
  @@index([serviceId, isActive, sortOrder])
}

// ------------------------------------
// GUEST OR AUTHENTICATED QUOTE REQUESTS
// ------------------------------------

model QuoteRequest {
  id              String      @id @default(cuid())
  name            String
  email           String
  companyName     String?
  companyWebsite  String?
  country         String?
  message         String      @db.Text
  goals           String?     @db.Text
  budgetRange     String?
  desiredDeadline DateTime?
  attachments     Json?
  status          QuoteStatus @default(NEW)
  internalNotes   String?     @db.Text

  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId    String?
  service      Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId    String?
  package      ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?           @relation("QuoteAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  project      Project?

  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
}

// ------------------------------------
// ACCEPTED WORK AND CLIENT COMMUNICATION
// ------------------------------------

model Project {
  id          String        @id @default(cuid())
  projectCode String        @unique
  title       String
  brief       String        @db.Text
  status      ProjectStatus @default(INTAKE)
  budget      Decimal?      @db.Decimal(10, 2)
  currency    String        @default("USD") @db.VarChar(3)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  clientId       String
  client         User            @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  assignedToId   String?
  assignedTo     User?           @relation("ProjectAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  serviceId      String?
  service        Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId      String?
  package        ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quoteRequestId String?         @unique
  quoteRequest   QuoteRequest?   @relation(fields: [quoteRequestId], references: [id], onDelete: SetNull)

  messages     ProjectMessage[]
  deliverables Deliverable[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId, updatedAt])
  @@index([status, dueDate])
  @@index([assignedToId, status])
}

model ProjectMessage {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body       String            @db.Text
  visibility MessageVisibility @default(CLIENT_VISIBLE)
  createdAt  DateTime          @default(now())

  @@index([projectId, createdAt])
  @@index([senderId, createdAt])
}

model Deliverable {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?           @db.Text
  fileUrl      String
  storageKey   String?           @unique
  previewUrl   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?
  version      Int               @default(1)
  status       DeliverableStatus @default(DRAFT)
  uploadedById String?
  uploadedBy   User?             @relation("DeliverableUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  sharedAt     DateTime?
  approvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

// ------------------------------------
// PUBLIC CONTACT INQUIRIES
// ------------------------------------

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

// ------------------------------------
// PORTFOLIO AND TESTIMONIAL CONTENT
// ------------------------------------

model PortfolioItem {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  summary       String    @db.Text
  industry      String?
  challenge     String?   @db.Text
  approach      String?   @db.Text
  outcomes      String?   @db.Text
  coverImageUrl String?
  gallery       Json?
  isConceptWork Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

model Testimonial {
  id                  String            @id @default(cuid())
  customerName        String
  customerTitle       String?
  companyName         String?
  quote               String            @db.Text
  rating              Int?
  permissionConfirmed Boolean           @default(false)
  status              TestimonialStatus @default(DRAFT)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, sortOrder])
}

// ------------------------------------
// INVITATIONS, OTP CHALLENGES, AND AUDIT LOGS
// ------------------------------------

model StaffInvitation {
  id           String    @id @default(cuid())
  email        String
  invitedRole  String
  tokenHash    String    @unique
  invitedById  String
  invitedBy    User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedById String?
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}

model AdminOtpChallenge {
  id         String    @id @default(uuid())
  sessionId  String    @unique
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}
