generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String           @id @default(uuid())
  name      String
  email     String           @unique
  password  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Blacklist {
  id        String   @id @default(uuid())
  jti       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
